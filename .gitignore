# NOTE: oxlint and oxfmt both read this file, so anything ignored here is also
# skipped by `pnpm run lint` / `pnpm run format`. Keep patterns narrow.

# Dependencies
node_modules/

# Build output — gitignored but load-bearing locally; `pnpm run build` recreates it
dist/
*.tsbuildinfo

# Test output
coverage/

# Tool caches / Vite's bundled-config temp files
.vite/
*.timestamp-*.mjs

# `pnpm publish --report-summary` regenerates this
pnpm-publish-summary.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.*
!.env.example

# Editors
!.vscode/extensions.json
.idea/
*.swp
*~

# Per-user agent settings (`.claude/settings.json` is shared and stays tracked)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
Desktop.ini
