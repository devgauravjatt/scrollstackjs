{
  "name": "@scrollstackjs/vue",
  "version": "0.1.1",
  "description": "Vue 3 adapter for ScrollStack — a headless useInfiniteScroll composable with scope-aware teardown. 0.29 KB gzipped.",
  "keywords": [
    "composable",
    "headless",
    "infinite-list",
    "infinite-scroll",
    "infinite-scrolling",
    "intersection-observer",
    "lazy-loading",
    "load-more",
    "pagination",
    "ssr",
    "typescript",
    "use-infinite-scroll",
    "vue",
    "vue-composable",
    "vue3"
  ],
  "homepage": "https://scrollstack.js.org/api/vue",
  "bugs": {
    "url": "https://github.com/devgauravjatt/scrollstackjs/issues"
  },
  "license": "MIT",
  "author": {
    "name": "devgauravjatt",
    "url": "https://github.com/devgauravjatt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgauravjatt/scrollstackjs.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@scrollstackjs/core": "workspace:^"
  },
  "devDependencies": {
    "@vue/test-utils": "latest",
    "vue": "latest"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  }
}
