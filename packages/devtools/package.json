{
  "name": "@scrollstackjs/devtools",
  "version": "0.1.1",
  "description": "Dev-only devtools panel for ScrollStack — live state, event timeline, page explorer and manual controls in a shadow-DOM overlay.",
  "keywords": [
    "debug-panel",
    "debugging",
    "developer-tools",
    "devtools",
    "event-timeline",
    "infinite-scroll",
    "infinite-scrolling",
    "inspector",
    "scrollstack",
    "shadow-dom",
    "state-inspector",
    "typescript"
  ],
  "homepage": "https://scrollstack.js.org/api/devtools",
  "bugs": {
    "url": "https://github.com/devgauravjatt/scrollstackjs/issues"
  },
  "license": "MIT",
  "author": {
    "name": "devgauravjatt",
    "url": "https://github.com/devgauravjatt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgauravjatt/scrollstackjs.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@scrollstackjs/core": "workspace:^"
  }
}
