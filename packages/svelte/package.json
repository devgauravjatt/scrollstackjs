{
  "name": "@scrollstackjs/svelte",
  "version": "0.1.0",
  "description": "Svelte adapter for ScrollStack — a headless infinite-scroll store.",
  "homepage": "https://github.com/devgauravjatt/scrollstackjs#readme",
  "bugs": {
    "url": "https://github.com/devgauravjatt/scrollstackjs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgauravjatt/scrollstackjs.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@scrollstackjs/core": "workspace:^"
  },
  "devDependencies": {
    "svelte": "latest"
  },
  "peerDependencies": {
    "svelte": ">=4"
  }
}
