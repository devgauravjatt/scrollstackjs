{
  "name": "@scrollstackjs/svelte",
  "version": "0.1.2",
  "description": "Svelte adapter for ScrollStack — a headless infinite-scroll store plus a sentinel action. Works in Svelte 4 and 5. 0.25 KB gzipped.",
  "keywords": [
    "headless",
    "infinite-list",
    "infinite-scroll",
    "infinite-scrolling",
    "intersection-observer",
    "lazy-loading",
    "load-more",
    "pagination",
    "ssr",
    "svelte",
    "svelte-action",
    "svelte-store",
    "svelte5",
    "sveltekit",
    "typescript"
  ],
  "homepage": "https://scrollstack.js.org/api/svelte",
  "bugs": {
    "url": "https://github.com/devgauravjatt/scrollstackjs/issues"
  },
  "license": "MIT",
  "author": {
    "name": "devgauravjatt",
    "url": "https://github.com/devgauravjatt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgauravjatt/scrollstackjs.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@scrollstackjs/core": "workspace:^"
  },
  "devDependencies": {
    "@scrollstackjs/virtual": "workspace:^",
    "svelte": "latest"
  },
  "peerDependencies": {
    "@scrollstackjs/virtual": ">=0.1.1",
    "svelte": ">=4"
  },
  "peerDependenciesMeta": {
    "@scrollstackjs/virtual": {
      "optional": true
    }
  }
}
