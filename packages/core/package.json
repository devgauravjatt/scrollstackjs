{
  "name": "@scrollstackjs/core",
  "version": "0.1.2",
  "description": "Headless, framework-agnostic infinite-scroll engine — pagination, retry, cancellation and an intersection trigger in 1.91 KB gzipped. Zero runtime dependencies.",
  "keywords": [
    "cursor-pagination",
    "framework-agnostic",
    "headless",
    "infinite-list",
    "infinite-scroll",
    "infinite-scrolling",
    "intersection-observer",
    "lazy-loading",
    "load-more",
    "pagination",
    "scroll",
    "ssr",
    "state-machine",
    "typescript",
    "zero-dependencies"
  ],
  "homepage": "https://scrollstack.js.org/api/core",
  "bugs": {
    "url": "https://github.com/devgauravjatt/scrollstackjs/issues"
  },
  "license": "MIT",
  "author": {
    "name": "devgauravjatt",
    "url": "https://github.com/devgauravjatt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgauravjatt/scrollstackjs.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  }
}
