{
  "name": "@scrollstackjs/virtual",
  "version": "0.1.2",
  "description": "Headless list virtualization for ScrollStack — render 50 rows out of 50,000, with dynamic measurement, window scrolling and an infinite-scroll bridge. Framework-agnostic.",
  "keywords": [
    "dynamic-height",
    "framework-agnostic",
    "headless",
    "infinite-scroll",
    "list-virtualization",
    "resize-observer",
    "scrollstack",
    "ssr",
    "typescript",
    "virtual-list",
    "virtual-scroll",
    "virtualization",
    "virtualized-list",
    "windowing"
  ],
  "homepage": "https://scrollstack.js.org/api/virtual",
  "bugs": {
    "url": "https://github.com/devgauravjatt/scrollstackjs/issues"
  },
  "license": "MIT",
  "author": {
    "name": "devgauravjatt",
    "url": "https://github.com/devgauravjatt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgauravjatt/scrollstackjs.git",
    "directory": "packages/virtual"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@scrollstackjs/core": "workspace:^"
  }
}
