{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // Shared base for the whole repo. Every workspace member has its own
  // `.oxlintrc.json` that `extends` this file — oxlint picks the *nearest*
  // config for each file and does NOT merge it with this one, so the per-package
  // configs must extend explicitly (they do).
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },

  "env": {
    "builtin": true,
    "browser": true
  },

  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/coverage/**", "**/*.d.ts"],

  "rules": {
    // ADR-002: page params are compared with `== null` on purpose — `0` and `''`
    // are valid page params. Enforce `===` everywhere else.
    "eqeqeq": ["error", "always", { "null": "ignore" }],

    // `isolatedModules` is on and the barrel re-exports types explicitly.
    "typescript/consistent-type-imports": "error",
    // Convention: interfaces over type aliases for object shapes.
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-asserted-optional-chain": "error",

    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-console": "warn",

    // The codebase models "absent" as `null` deliberately (`error: unknown`,
    // `createIntersectionTrigger` returning `null` under SSR).
    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",

    "promise/no-return-wrap": "error",
    "promise/param-names": "error",

    // Side-effect imports for stylesheets and polyfills are intentional.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss", "**/*.postcss"] }]
  },

  "overrides": [
    {
      // Vitest suites: `tests/*.test.ts(x)`, importing from `../src/index`.
      "files": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "plugins": ["vitest"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        // `tests/helpers.ts` names them `res`/`rej`; test doubles are untyped on purpose.
        "promise/param-names": "off",
        "vitest/require-mock-type-parameters": "off"
      }
    },
    {
      // Build/tool config files run in Node, not the browser.
      "files": ["**/*.config.ts", "**/*.config.js", "**/*.config.mjs"],
      "env": { "node": true },
      "rules": {
        "import/no-nodejs-modules": "off",
        "no-console": "off"
      }
    }
  ]
}
