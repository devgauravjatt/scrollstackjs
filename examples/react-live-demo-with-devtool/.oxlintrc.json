{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],

  "plugins": ["react", "react-perf", "jsx-a11y"],

  "rules": {
    // Off — the demos render engine errors with String(error), and `error` is
    // typed `unknown`. Every error these demos can actually produce is an Error
    // from their fetch helpers, so the [object Object] case the rule guards
    // against cannot occur here.
    "typescript/no-base-to-string": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    // Examples double as documentation — logging and inline demo styles are fine.
    "no-console": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off"
  }
}
