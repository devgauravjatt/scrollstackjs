{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],

  "plugins": ["vue"],

  "rules": {
    // Off — the demos render engine errors with String(error), and `error` is
    // typed `unknown`. Every error these demos can actually produce is an Error
    // from their fetch helpers, so the [object Object] case the rule guards
    // against cannot occur here.
    "typescript/no-base-to-string": "off",
    // Examples double as documentation — logging is fine.
    "no-console": "off"
  }
}
